# WashFlow Microservices Environment Variables Template
# Copy this file to '.env' and populate with your actual values for local execution or Docker Compose.

# --- MongoDB Connection Strings ---
# Service-specific MongoDB connection URIs (or local container defaults)
MONGODB_URI_USER_AUTH=mongodb://mongodb:27017/washflow_users
MONGODB_URI_LAUNDRY=mongodb://mongodb:27017/washflow_catalog
MONGODB_URI_ORDER_PICKUP=mongodb://mongodb:27017/washflow_orders

# --- API Keys ---
# Service-specific API Keys (Recommended for security isolation between microservices)
USER_AUTH_SERVICE_API_KEY=washflow-user-auth-dev-key-2026
LAUNDRY_SERVICE_API_KEY=washflow-laundry-dev-key-2026
ORDER_PICKUP_SERVICE_API_KEY=washflow-order-pickup-dev-key-2026

# Shared API Key (Can be set to use the same key across all services)
SERVICE_API_KEY=washflow-shared-dev-key-2026

# --- Authentication & JWT ---
# HMAC SHA Secret key used for signing and validating JWT tokens (Must be at least 256-bit / 32 characters)
JWT_SECRET=washflow-jwt-super-secret-key-2026-washflow-microservices-coursework-dev-secret-key-32bytes

# --- Internal Microservice URLs (Used by API Gateway inside Docker network) ---
USER_AUTH_SERVICE_URL=http://user-auth-service:8081
LAUNDRY_SERVICE_URL=http://laundry-service:8082
ORDER_PICKUP_SERVICE_URL=http://order-pickup-service:8083
